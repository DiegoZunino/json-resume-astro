# Copy to .env (never committed) to build from your own resume. Every variable is optional.

# Public address of the site: canonical URLs, sitemap, social previews.
SITE_URL=https://example.org

# One source per language, a file path or a URL (gist raw URL, API). Overrides resume.config.ts.
# RESUME_SOURCE_IT=../cv/resume.json
# RESUME_SOURCE_EN=https://gist.githubusercontent.com/<user>/<id>/raw/resume.en.json

# 1 = a photo that cannot be fetched stops the build instead of falling back to a monogram.
# RESUME_STRICT_PHOTO=1
