{
  "name": "json-resume-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "astro": "7.3.5",
    "playwright": "1.56.0",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@jsonresume/schema": "1.3.1",
    "@playwright/test": "1.56.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sirv-cli": "3.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "description": "A generic, accessible front end for JSON Resume built with Astro: web page, PDF, social card and structured data from one file.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoZunino/json-resume-astro.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "sirv dist --port 4321 --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "verify": "npm run lint && npm run check && npm test && npm run build && npm run validate:html && npm run test:e2e"
  },
  "overrides": {
    "playwright-core": "1.56.0"
  }
}
