---
/** Web page frame: document metadata, top bar, main content, footer. */
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';
import { referenceDate } from '../core/dates';
import { profilePage } from '../core/jsonld';
import { joinParts } from '../core/text';
import { alternatesFor, ogLocale, type PageContext } from '../site/context';
import { optimisedPhoto } from '../site/photo';
import Document, { type Alternate } from './Document.astro';

interface Props {
  context: PageContext;
  /** Page title; defaults to "Name · Label". */
  title?: string;
  /** Canonical URL; the home page by default. */
  canonical?: string;
  alternates?: Alternate[];
  /** The home page carries the structured data. */
  structuredData?: boolean;
  /** Pages that are not for search engines (the confirmation after sending a message). */
  noindex?: boolean;
  /** The secondary page this is, marked in the footer links. */
  current?: 'accessibility' | 'privacy';
}

const { context, title, canonical, alternates, structuredData = false, noindex = false, current } = Astro.props;
const { resume, labels, locale } = context;
const pageTitle = title ?? joinParts([resume.basics.name, resume.basics.label]);
const updated = resume.meta.lastModified ? referenceDate(resume.meta.lastModified, new Date(0)) : undefined;
// Same options as the hero photo, so the structured data points to the same published file.
const photo = structuredData ? await optimisedPhoto(resume.basics.image, 168) : undefined;
const photoUrl = photo && Astro.site ? new URL(photo.src, Astro.site).href : undefined;
---

<Document
  lang={locale}
  title={pageTitle}
  description={context.description}
  canonical={noindex ? undefined : (canonical ?? context.absoluteHomeUrl)}
  alternates={noindex ? [] : (alternates ?? alternatesFor((other) => getAbsoluteLocaleUrl(other)))}
  ogImage={context.ogImageUrl}
  ogLocale={ogLocale(locale)}
  jsonLd={structuredData ? profilePage(resume, context.absoluteHomeUrl, photoUrl) : undefined}
  dataAlternate={context.dataUrl}
  noindex={noindex}
>
  <TopBar labels={labels} otherLocales={context.otherLocales} />
  <main id="content" class="page" tabindex="-1">
    <slot />
  </main>
  <Footer
    labels={labels}
    updated={updated}
    repository={context.repository}
    accessibilityUrl={context.accessibilityUrl}
    privacyUrl={context.privacyUrl}
    current={current}
    dataUrl={context.dataUrl}
    otherLocales={context.otherLocales}
  />
</Document>
