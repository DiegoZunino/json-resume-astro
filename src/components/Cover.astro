---
/**
 * The header band (`meta.themeOptions.cover`): the owner's image, light and dark, behind
 * the photo and the name, the way a profile cover sits on LinkedIn. An image with the
 * page's own background colour blends into the page; any other image reads as a band. Purely decorative: no
 * alternative text, hidden from assistive technology, left out of print. Both images are
 * lazy, so only the one for the current theme is downloaded.
 */
import { optimisedCover } from '../site/cover';

interface Props {
  light: string;
  dark?: string | undefined;
}

const { light, dark } = Astro.props;
const [lightImage, darkImage] = await Promise.all([optimisedCover(light), optimisedCover(dark)]);
// The image keeps the scale it has in the page frame on every screen: narrower screens
// show its left part (where a profile cover leaves room for the photo), never a shrunk copy.
const SIZES = '63.5rem';
---

{lightImage && (
  <div class="cover" aria-hidden="true">
    <img
      class:list={['cover-image', { light: Boolean(darkImage) }]}
      src={lightImage.src}
      srcset={lightImage.srcSet.attribute}
      sizes={SIZES}
      alt=""
      decoding="async"
      loading="lazy"
    />
    {darkImage && (
      <img
        class="cover-image dark"
        src={darkImage.src}
        srcset={darkImage.srcSet.attribute}
        sizes={SIZES}
        alt=""
        decoding="async"
        loading="lazy"
      />
    )}
  </div>
)}

<style>
  /* The image fades out at the bottom and at the sides, so it melts into the page and
     never draws a rectangle behind the name. */
  .cover {
    height: clamp(8.5rem, 6rem + 8vw, 11rem);
    overflow: hidden;
    border-radius: 1.375rem;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent, #000 1.25rem, #000 40%, transparent 92%),
      linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
    mask-image:
      linear-gradient(to bottom, transparent, #000 1.25rem, #000 40%, transparent 92%),
      linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .cover-image {
    width: 100%;
    min-width: 63.5rem;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }
  /* One image per theme: the system's, unless the visitor chose one. */
  .dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .light {
    display: none;
  }
  :global(:root[data-theme='dark']) .dark {
    display: block;
  }
  /* On a phone the band runs edge to edge. */
  @media (max-width: 30rem) {
    .cover {
      margin-inline: -1.25rem;
      border-radius: 0;
      -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 92%);
      mask-image: linear-gradient(to bottom, #000 40%, transparent 92%);
    }
  }
  /* Decoration only: on paper and in high-contrast modes the page goes without it. */
  @media print, (forced-colors: active) {
    .cover {
      display: none;
    }
  }
</style>
