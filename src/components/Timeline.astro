---
/**
 * Career timeline (WAI-ARIA accordion pattern: heading > button[aria-expanded]).
 * Every role with something to read opens and closes; the most recent `expanded` roles
 * start open. Server-rendered fully open, so it works without JavaScript and in print.
 * Each row pairs the role (left) with a bar on a shared time axis (right): pointing at a
 * role lights its bar and marks its years on the axis. Bars are SVG geometry, not inline
 * styles, so they survive a strict CSP and are repainted in forced-colours mode.
 */
import { formatRange } from '../core/dates';
import { joinParts } from '../core/text';
import type { WorkItem } from '../core/schema';
import { buildTimeline, hasDetails } from '../core/timeline';
import type { Labels } from '../i18n/labels';
import Icon from './Icon.astro';

interface Props {
  work: WorkItem[];
  labels: Labels;
  reference: Date;
  /** Number of roles, from the top, left open after the script runs. */
  expanded: number;
  idPrefix?: string;
}

const { work, labels, reference, expanded, idPrefix = 'role' } = Astro.props;
const { entries, years } = buildTimeline(work, reference);
const collapsible = hasDetails;
const hasOrg = (item: WorkItem) => Boolean(item.position && item.name);
const hasDates = (item: WorkItem) => Boolean(item.startDate || item.endDate);
const range = (item: WorkItem) => formatRange(item.startDate, item.endDate, labels.intl, labels.ongoing);
// The parts are separate blocks on screen, which screen readers would join with stray
// spaces; the name is given whole instead: "Tech Lead, Azienda Uno, giu 2019 – feb 2022".
const accessibleName = (item: WorkItem) =>
  joinParts([item.position ?? item.name, hasOrg(item) && item.name, hasDates(item) && range(item)], ', ');
---

<div class="timeline" data-timeline data-open={expanded}>
  {years.length > 0 && (
    <div class="axis" aria-hidden="true">
      <span class="axis-hint" data-axis-hint></span>
      <svg class="years" width="100%" height="34" focusable="false">
        {years.map((tick) => (
          <text x={`${tick.x}%`} y="13" text-anchor="middle">
            {tick.year}
          </text>
        ))}
        <rect class="axis-span" data-axis-span x="0" y="24" width="0" height="5" rx="2.5" />
      </svg>
    </div>
  )}
  <ol class="roles">
    {entries.map(({ item, current, bar }, index) => {
      const open = collapsible(item);
      const Head = open ? 'button' : 'span';
      return (
        <li
          class:list={['role', { current }]}
          data-role
          data-x={bar?.x}
          data-w={bar?.width}
          data-when={hasDates(item) ? range(item) : undefined}
        >
          <div class="line">
            <h3 class="label">
              {!open && <span class="visually-hidden">{accessibleName(item)}</span>}
              <Head
                {...(open
                  ? {
                      type: 'button',
                      'aria-expanded': 'true',
                      'aria-controls': `${idPrefix}-${index}`,
                      'aria-label': accessibleName(item),
                    }
                  : { 'aria-hidden': 'true' })}
                class="head"
              >
                <span class="what">
                  <span class="position">
                    {item.position ?? item.name}
                    {current && <span class="now" />}
                  </span>
                  <span class="meta">{joinParts([hasOrg(item) && item.name, hasDates(item) && range(item)])}</span>
                </span>
                {open && <Icon name="chevron" size={16} class="chevron" />}
              </Head>
            </h3>
            {bar && (
              <svg class="bar" width="100%" height="10" aria-hidden="true" focusable="false">
                <rect class="track" x="0" y="0" width="100%" height="10" rx="5" />
                <rect class="span" x={`${bar.x}%`} y="0" width={`${bar.width}%`} height="10" rx="5" />
              </svg>
            )}
          </div>
          {open && (
            <div class="panel" id={`${idPrefix}-${index}`}>
              {item.location ? <p class="where">{item.location}</p> : <span class="where" />}
              <div class="body">
                {item.description && <p class="context">{item.description}</p>}
                {item.summary && <p>{item.summary}</p>}
                {item.highlights?.length ? (
                  <ul>
                    {item.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                ) : null}
              </div>
            </div>
          )}
        </li>
      );
    })}
  </ol>
</div>

<script>
  import { initTimelines } from '../site/timeline';
  initTimelines();
</script>

<style>
  .axis {
    display: none;
  }
  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The rule is drawn apart from the row, so the row's rounded hover never bends it. */
  .role {
    position: relative;
    border-radius: 0.625rem;
    transition: background-color 0.2s ease;
  }
  .role::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    border-top: 1px solid var(--linea);
  }
  .role:hover,
  .role:has(.head:focus-visible) {
    background: var(--hover);
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding: 0.75rem 0.5rem;
  }
  .label {
    flex: 1 1 100%;
    min-width: 0;
    margin: 0;
    font-size: inherit;
  }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
  }
  button.head {
    cursor: pointer;
  }
  .what {
    flex: 1;
    min-width: 0;
  }
  .position {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
  }
  /* The role under the pointer or focus turns ochre (a darker shade on the light page,
     to stay readable). */
  .position {
    transition: color 0.15s ease;
  }
  button.head:hover .position,
  button.head:focus-visible .position {
    color: var(--oro-testo);
  }
  .now {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gru);
    /* Two beats, done within five seconds of load (WCAG 2.2.2). */
    animation: pulse 2s ease-out 1s 2;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--gru);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .meta {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--nebbia);
    font-variant-numeric: tabular-nums;
  }
  :global(.chevron) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--mare);
    transition: transform 0.2s ease;
  }
  h3 > button[aria-expanded='true'] :global(.chevron) {
    transform: rotate(90deg);
  }
  .bar {
    flex: 1 1 var(--body-min);
    min-width: 0;
    height: 0.625rem;
    display: none;
  }
  .track {
    fill: var(--traccia);
  }
  .span {
    fill: var(--barra);
    transform-box: fill-box;
    transform-origin: left center;
    animation: grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    transition: fill 0.2s ease;
  }
  .role:nth-child(2) .span {
    animation-delay: 0.08s;
  }
  .role:nth-child(3) .span {
    animation-delay: 0.16s;
  }
  .role:nth-child(4) .span {
    animation-delay: 0.24s;
  }
  .role:nth-child(5) .span {
    animation-delay: 0.32s;
  }
  .role:nth-child(n + 6) .span {
    animation-delay: 0.4s;
  }
  /* Ochre means "now": the role under the pointer or focus is marked in sea green. */
  .current .span {
    fill: var(--gru);
  }
  .role:hover .span,
  .role:has(.head:focus-visible) .span {
    fill: var(--mare);
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .panel {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    padding: 0 0.5rem 1rem;
    animation: fade 0.25s ease-out both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .where {
    flex: 1 1 100%;
    margin: 0 0 0.375rem;
    font-size: 0.8125rem;
    color: var(--nebbia);
  }
  .body {
    flex: 1 1 var(--body-min);
    min-width: 0;
    max-width: var(--measure);
    font-size: 0.9375rem;
    color: var(--testo);
  }
  .body p {
    margin: 0;
  }
  .context {
    margin-bottom: 0.375rem !important;
    font-size: 0.8125rem;
    color: var(--nebbia);
  }
  /* Highlights: a small dot in the colour of past bars (the ochre dash marks talks). */
  .body ul {
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .body li {
    margin-bottom: 0.25rem;
    padding-left: 1rem;
  }
  /* In the text flow (hanging indent), not positioned: printed, the text keeps its order. */
  .body li::before {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin: 0 0.5rem 0 -0.875rem;
    border-radius: 50%;
    background: var(--barra);
    vertical-align: 0.12em;
    /* Browsers print without backgrounds unless told: the dot is content, not decoration. */
    print-color-adjust: exact;
  }
  .role:has(button[aria-expanded='false']) .panel {
    display: none;
  }

  /* Wide screens: the time axis and one bar per role. */
  @media (min-width: 52rem) {
    .label,
    .where {
      flex: 0 1 var(--label);
    }
    .where {
      margin-bottom: 0;
    }
    .axis {
      display: flex;
      gap: 0 1.5rem;
      padding: 0 0.5rem 0.25rem;
      color: var(--nebbia);
    }
    .axis-hint {
      flex: 0 1 var(--label);
      font-size: 0.8125rem;
      line-height: 1rem;
      align-self: flex-start;
    }
    .years {
      flex: 1 1 var(--body-min);
      overflow: visible;
    }
    .years text {
      fill: currentColor;
      font-size: 0.75rem;
    }
    .axis-span {
      fill: var(--mare);
      opacity: 0;
    }
    .axis-span[data-on] {
      opacity: 1;
    }
    .axis-span {
      transition:
        opacity 0.2s ease,
        x 0.25s ease,
        width 0.25s ease;
    }
    .bar {
      display: block;
    }
  }

  /* Below the fold the bars and the pulse wait until the timeline scrolls into view. */
  [data-reveal='wait'] .span,
  [data-reveal='wait'] .now {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .span,
    .panel,
    .now {
      animation: none;
    }
  }
  @media print {
    .axis,
    .bar,
    :global(.chevron) {
      display: none;
    }
    /* Ctrl+P must show every role in full, not a panel caught at the start of its fade. */
    .panel {
      display: block !important;
      animation: none !important;
      opacity: 1;
      transform: none;
    }
    .role:hover {
      background: none;
    }
  }
  @media (forced-colors: active) {
    .span,
    .current .span,
    .role:hover .span,
    .role:has(.head:focus-visible) .span {
      fill: CanvasText;
    }
    .track {
      fill: Canvas;
      stroke: CanvasText;
      stroke-width: 0.5;
    }
  }
</style>
