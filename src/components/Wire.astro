---
/**
 * The wire: an ochre line between where the work starts and where it lands, the single
 * drawn element of the identity (hero, PDF, social card).
 *
 *   Where it starts  ●──────────●  where it lands
 *
 * On the web it tells the passage in sequence: the first phrase, the line drawing
 * itself towards the right, then the destination. Drawn with borders, not backgrounds,
 * so it stays visible in forced-colours mode. The two phrases carry the meaning; the
 * line is hidden from assistive technology.
 */
interface Props {
  from: string;
  to: string;
  /** Tell it in sequence on load (web only; skipped with reduced motion). */
  animate?: boolean;
  class?: string;
}

const { from, to, animate = false, class: className } = Astro.props;
---

<p class:list={['wire', className, { animate }]}>
  <span class="from">{from}</span>
  <span class="line" aria-hidden="true">
    <span class="stroke"></span>
  </span>
  <span class="to">{to}</span>
</p>

<style>
  .wire {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em 0.75em;
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .to {
    color: var(--mare);
  }
  .line {
    flex: 1 1 3em;
    min-width: 3em;
    max-width: 9em;
    display: flex;
    align-items: center;
    height: 0.7em;
  }
  .stroke {
    position: relative;
    flex: 1;
    height: 0;
    border-top: 4px solid var(--gru);
    margin-inline: 0.25em;
  }
  .stroke::before,
  .stroke::after {
    content: '';
    position: absolute;
    top: -0.3em;
    width: 0;
    height: 0;
    border: 0.25em solid var(--gru);
    border-radius: 50%;
    margin-top: -2px;
  }
  .stroke::before {
    left: -0.3em;
  }
  .stroke::after {
    right: -0.3em;
  }
  .animate .from {
    animation: enter 0.5s ease-out 0.05s both;
  }
  .animate .stroke {
    transform-origin: left center;
    animation: draw 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.55s both;
  }
  .animate .to {
    animation: enter 0.6s ease-out 1.45s both;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateX(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate .from,
    .animate .stroke,
    .animate .to {
      animation: none;
    }
  }
</style>
