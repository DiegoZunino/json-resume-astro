---
/**
 * The wire: one yellow line that leads from where the work starts to where it lands.
 * It is the single drawn element of the identity (hero, PDF, social card).
 *
 *   Where it starts
 *   ●────────────────● where it lands
 *
 * Drawn with borders, not backgrounds, so it stays visible in forced-colours mode.
 * Decorative: the two phrases carry the meaning, the line is hidden from assistive tech.
 */
interface Props {
  from: string;
  to: string;
  /** Draw it once on load (web only; skipped with reduced motion). */
  animate?: boolean;
  class?: string;
}

const { from, to, animate = false, class: className } = Astro.props;
---

<p class:list={['wire', className, { animate }]}>
  <span class="from">{from}</span>
  <span class="line" aria-hidden="true"></span>
  <span class="to">{to}</span>
</p>

<style>
  .wire {
    display: grid;
    grid-template-columns: minmax(2.5em, 1fr) auto;
    align-items: center;
    column-gap: 0.55em;
    row-gap: 0.2em;
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .from {
    grid-column: 1 / -1;
  }
  .to {
    text-wrap: balance;
  }
  .line {
    position: relative;
    height: 0;
    border-top: 3px solid var(--gru);
    border-radius: 2px;
    transform-origin: left center;
  }
  .line::before,
  .line::after {
    content: '';
    position: absolute;
    top: -0.32em;
    width: 0;
    height: 0;
    border: 0.25em solid var(--gru);
    border-radius: 50%;
    margin-top: -1.5px;
  }
  .line::before {
    left: -0.1em;
  }
  .line::after {
    right: -0.1em;
  }
  .animate .line {
    animation: draw 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.25s both;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate .line {
      animation: none;
    }
  }
</style>
