---
/** Skip link, theme choice and language links. */
import type { LocaleLink } from '../site/context';
import type { Labels } from '../i18n/labels';

interface Props {
  labels: Labels;
  otherLocales: LocaleLink[];
}

const { labels, otherLocales } = Astro.props;
const choices = [
  { value: 'system', label: labels.theme.system },
  { value: 'light', label: labels.theme.light },
  { value: 'dark', label: labels.theme.dark },
] as const;
---

<header class="topbar page">
  <a class="skip" href="#content">
    {labels.skipToContent}
  </a>
  <!-- Without JavaScript the choice could not be kept, so the page follows the system and the control stays hidden. -->
  <fieldset class="theme" data-theme-switch hidden>
    <legend class="visually-hidden">{labels.theme.legend}</legend>
    {choices.map((choice) => (
      <label>
        <input type="radio" name="theme" value={choice.value} checked={choice.value === 'system'} />
        <span>{choice.label}</span>
      </label>
    ))}
  </fieldset>
  {otherLocales.length > 0 && (
    <nav aria-label={labels.languageNav}>
      <ul>
        {otherLocales.map((link) => (
          <li>
            <a href={link.href} hreflang={link.locale} lang={link.locale}>
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

<script>
  import { initThemeSwitch } from '../site/theme';
  initThemeSwitch();
</script>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    min-height: 3.5rem;
    padding-top: 0.75rem;
    font-size: var(--step--1);
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -10rem;
    padding: 0.5rem 0.9rem;
    background: var(--mare);
    color: var(--mare-ink);
    border-radius: var(--radius);
    z-index: 10;
  }
  .skip:focus {
    top: 0.75rem;
  }
  /* Segmented control: three native radios, so arrow keys and screen readers work as usual. */
  .theme {
    display: inline-flex;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--linea);
    border-radius: var(--radius);
    background: var(--superficie);
  }
  .theme label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    min-width: 2.75rem;
    justify-content: center;
    padding: 0 0.7rem;
    border-radius: calc(var(--radius) - 2px);
    color: var(--nebbia);
    font-weight: 560;
    cursor: pointer;
  }
  .theme input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .theme label:hover {
    color: var(--ardesia);
  }
  /* The chosen option is marked, not filled: the download button stays the only solid block. */
  .theme label:has(:checked) {
    background: color-mix(in srgb, var(--mare) 14%, var(--superficie));
    color: var(--mare);
    box-shadow: inset 0 0 0 1.5px var(--mare);
    font-weight: 650;
  }
  @media (pointer: coarse) {
    .theme label {
      min-height: 2.75rem;
    }
  }
  .theme label:has(:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  nav ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 560;
  }
  @media (forced-colors: active) {
    .theme label:has(:checked) {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }
  }
  @media print {
    .topbar {
      display: none;
    }
  }
</style>
