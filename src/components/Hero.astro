---
/**
 * First screen: who (photo, name), what (role), the line that ties the work together,
 * the actions, then the introduction. Answers "who is this, what do they do, what can I
 * do here" without scrolling; the actions come before the introduction in the reading
 * order too, so keyboard and screen-reader users reach them as quickly.
 */
import type { Resume } from '../core/schema';
import type { Labels } from '../i18n/labels';
import Actions from './Actions.astro';
import Cover from './Cover.astro';
import Photo from './Photo.astro';
import Wire from './Wire.astro';

interface Props {
  resume: Resume;
  labels: Labels;
  pdfUrl: string;
}

const { resume, labels, pdfUrl } = Astro.props;
const { basics } = resume;
const options = resume.meta.themeOptions ?? {};
const intro = options.intro ?? (basics.summary ? [basics.summary] : []);
/** "Customer Engineer · Senior Software Developer": each part stays on one line. */
const roleParts = basics.label?.split(/\s+[·|–—]\s+/).filter(Boolean) ?? [];
/** Mirrors --photo-size below, so the browser downloads the smallest file that is sharp. */
const PHOTO_SIZES = '(max-width: 30rem) 7rem, 9.25rem';
---

<div class="hero">
  {options.cover && <Cover light={options.cover.light} dark={options.cover.dark} />}
  <div class="identity">
    <Photo src={basics.image} name={basics.name} size={148} sizes={PHOTO_SIZES} eager />
    <div>
      <h1 class="name">{basics.name}</h1>
      {roleParts.length > 0 && (
        <p class="role">
          {roleParts.map((part, index) => (
            <>
              {index > 0 && <span class="sep"> · </span>}
              <span class="part">{part}</span>
            </>
          ))}
        </p>
      )}
      {basics.location?.city && <p class="place muted">{basics.location.city}</p>}
    </div>
  </div>

  {options.tagline && <Wire class="tagline" from={options.tagline.from} to={options.tagline.to} animate />}

  <Actions resume={resume} labels={labels} pdfUrl={pdfUrl} label={labels.actions} />

  {intro.length > 0 && (
    <div class="intro measure">
      {intro.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  )}
</div>

<style>
  .hero {
    padding-top: clamp(1.5rem, 5vw, 3rem);
  }
  .identity {
    --photo-size: 9.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }
  .identity :global(.photo) {
    animation: ring 1.9s ease-out both;
  }
  /* With a cover the photo rises into its lower edge, the name stays below it. */
  .hero:has(.cover) {
    padding-top: 0.5rem;
  }
  .hero:has(.cover) .identity {
    --overlap: 3.25rem;
    align-items: flex-start;
    margin-top: calc(-1 * var(--overlap));
    padding-left: 1.5rem;
  }
  .hero:has(.cover) .identity > div {
    padding-top: calc(var(--overlap) + 0.5rem);
  }
  /* A ring of page colour outside the ochre one, so the photo stands off the image. */
  .hero:has(.cover) .identity :global(.photo) {
    outline: 5px solid var(--pietra);
    outline-offset: 4px;
  }
  @media (max-width: 36rem) {
    .hero:has(.cover) .identity {
      padding-left: 0;
    }
    .hero:has(.cover) .identity > div {
      padding-top: 0;
    }
  }
  @keyframes ring {
    0%,
    70% {
      box-shadow: 0 0 0 0 transparent;
    }
    100% {
      box-shadow: 0 0 0 4px var(--gru);
    }
  }
  @media (max-width: 30rem) {
    .identity {
      --photo-size: 7rem;
    }
  }
  .name {
    margin: 0;
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .role {
    margin: 0.625rem 0 0;
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--mare);
    line-height: 1.35;
  }
  .part {
    white-space: nowrap;
  }
  /* On a phone each part of the role takes its own line, so no separator hangs at a line
     end; the separator stays for screen readers. */
  @media (max-width: 30rem) {
    .part {
      display: block;
    }
    .sep {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* On the narrowest screens (or with wider letter spacing) a part may wrap after all. */
  @media (max-width: 22rem) {
    .part {
      white-space: normal;
    }
  }
  .place {
    margin: 0.125rem 0 0;
    font-size: 0.9375rem;
  }
  .hero :global(.tagline) {
    margin: 2.75rem 0 0;
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.5rem);
  }
  .hero :global(.actions) {
    margin-top: 2rem;
  }
  .intro {
    margin-top: 1.875rem;
    color: var(--testo);
    line-height: 1.65;
  }
  .intro p {
    margin: 0 0 0.75rem;
  }
  .intro p:last-child {
    margin-bottom: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .identity :global(.photo) {
      animation: none;
      box-shadow: 0 0 0 4px var(--gru);
    }
  }
  @media print {
    .identity :global(.photo) {
      animation: none;
      box-shadow: none;
      outline: 0;
    }
    .hero:has(.cover) .identity {
      margin-top: 0;
      padding-left: 0;
    }
  }
</style>
