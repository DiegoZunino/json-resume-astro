---
/**
 * A list of entries (talks, projects, publications, awards, volunteering, extension
 * lists) on the page's shared grid. A plain line of text hangs from an ochre dash, with
 * no rules between lines; a titled entry shows its meta line (event, date) in the label
 * column and its title, linked if there is a URL, with summary and points in the body.
 * The title comes first in the document, so screen readers and the text a recruiting
 * system extracts from the PDF read "what" before "when"; the meta is moved left by CSS.
 */
export interface ListEntry {
  title: string;
  url?: string | undefined;
  meta?: string | undefined;
  summary?: string | undefined;
  points?: string[] | undefined;
  lang?: string | undefined;
}

interface Props {
  entries: ListEntry[];
  /** One line above the list, e.g. "In Italian." when every entry is in another language. */
  note?: string | undefined;
}

const { entries, note } = Astro.props;
const isPlain = (entry: ListEntry) => !entry.url && !entry.meta && !entry.summary && !entry.points?.length;
---

{note && <p class="note">{note}</p>}
<ul class="rows entries">
  {entries.map((entry) =>
    isPlain(entry) ? (
      <li class="row plain">
        <span class="row-label mark" aria-hidden="true">
          <span></span>
        </span>
        <p class="row-body" lang={entry.lang}>
          {entry.title}
        </p>
      </li>
    ) : (
      <li class="row">
        <div class="row-body">
          <p class="title" lang={entry.lang}>
            {entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}
          </p>
          {entry.summary && <p class="summary">{entry.summary}</p>}
          {entry.points?.length ? (
            <ul class="points">
              {entry.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          ) : null}
        </div>
        {entry.meta ? <p class="row-label meta">{entry.meta}</p> : <span class="row-label" />}
      </li>
    ),
  )}
</ul>

<style>
  .note {
    margin: -0.5rem 0 0.75rem;
    font-size: var(--step--1);
    color: var(--nebbia);
  }
  .row-label {
    order: -1;
  }
  /* Plain lines: one list, no rules inside it; the dash hangs just before the text. */
  .plain + .plain {
    border-top: 0;
  }
  .plain {
    padding-block: 0.375rem;
  }
  .plain:first-child {
    padding-top: 0.875rem;
  }
  .mark {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 1.6em;
  }
  .mark span {
    print-color-adjust: exact;
    width: 1.125rem;
    height: 3px;
    border-radius: 2px;
    background: var(--gru);
  }
  .meta {
    font-size: var(--step--1);
    color: var(--nebbia);
    padding-top: 0.15rem;
  }
  .title {
    margin: 0;
    font-weight: 600;
    color: var(--ardesia);
  }
  .summary {
    margin: 0.25rem 0 0;
  }
  .points {
    margin-top: 0.375rem;
    padding-left: 1.125rem;
  }
  /* When the body would fall under the label, the dash stays on the text's line. */
  @media screen and (max-width: 51.99rem) {
    .plain {
      flex-wrap: nowrap;
      gap: 0.75rem;
    }
    .plain .mark {
      flex: 0 0 1.125rem;
    }
  }
  /* On paper (the PDF and Ctrl+P): no rules between entries, just a little air; a plain
     line keeps its short dash and takes the full width, no empty label column. */
  @media print {
    .entries > .row {
      padding: 0 0 1.4mm;
      border: 0;
      break-inside: avoid;
    }
    .plain {
      flex-wrap: nowrap;
      gap: 2mm;
    }
    .plain .mark {
      flex: 0 0 3mm;
      height: 1.42em;
    }
    .mark span {
      width: 3mm;
      height: 1.2pt;
    }
    /* On paper a dated entry is one column, the title then its meta line: that is also
       the order of the text a recruiting system extracts from the PDF. */
    .row-label.meta {
      order: 0;
      flex-basis: 100%;
      padding-top: 0;
    }
    .row:has(.meta) > .row-body {
      flex-basis: 100%;
    }
    .row-label:not(.meta):empty {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .mark span {
      background: CanvasText;
    }
  }
</style>
