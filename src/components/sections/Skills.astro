---
/** Skill groups on the page's shared grid: the group in the label column, the keywords in the body. */
import type { Resume } from '../../core/schema';

interface Props {
  skills: Resume['skills'];
}

const { skills } = Astro.props;
---

<dl class="rows pairs">
  {skills.map((skill) => (
    <div class="row">
      <dt class="row-label">{skill.name}</dt>
      <dd class="row-body">
        {skill.keywords?.join(', ')}
        {skill.level && <span class="muted"> · {skill.level}</span>}
      </dd>
    </div>
  ))}
</dl>

<style>
  dt {
    font-weight: 700;
    color: var(--ardesia);
  }
</style>
