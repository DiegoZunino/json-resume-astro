---
/** Education, certifications and languages: what a recruiter checks together. */
import { formatDate, formatRange } from '../../core/dates';
import type { Resume } from '../../core/schema';
import { joinParts, languageLine } from '../../core/text';
import type { Labels } from '../../i18n/labels';

interface Props {
  resume: Resume;
  labels: Labels;
}

const { resume, labels } = Astro.props;
const date = (value?: string) => formatDate(value, labels.intl, labels.ongoing);
const certificateDetails = (certificate: Resume['certificates'][number]) =>
  joinParts(
    [
      certificate.issuer,
      certificate.date && date(certificate.date),
      certificate['x-validUntil'] && `${labels.validUntil} ${date(certificate['x-validUntil'])}`,
    ],
    ', ',
  );
---

<dl class="rows pairs">
  {resume.education.map((entry) => (
    <div class="row">
      <dt class="row-label">{joinParts([entry.studyType, entry.area], ', ') || entry.institution}</dt>
      <dd class="row-body">
        {entry.url ? <a href={entry.url}>{entry.institution}</a> : entry.institution}
        {(entry.startDate || entry.endDate) && (
          <span class="muted"> · {formatRange(entry.startDate, entry.endDate, labels.intl, labels.ongoing)}</span>
        )}
      </dd>
    </div>
  ))}
  {resume.certificates.length > 0 && (
    <div class="row">
      <dt class="row-label">{labels.sections.certificates}</dt>
      <dd class="row-body">
        <ul>
          {resume.certificates.map((certificate) => (
            <li>
              {certificate.url ? <a href={certificate.url}>{certificate.name}</a> : certificate.name}
              <span class="muted">{certificateDetails(certificate) && `, ${certificateDetails(certificate)}`}</span>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  )}
  {resume.languages.length > 0 && (
    <div class="row">
      <dt class="row-label">{labels.sections.languages}</dt>
      <dd class="row-body">
        {resume.languages.map((entry) => languageLine(entry.language, entry.fluency)).join(', ')}
      </dd>
    </div>
  )}
</dl>

<style>
  dt {
    font-weight: 700;
    color: var(--ardesia);
  }
  dd ul {
    list-style: none;
    padding: 0;
  }
</style>
