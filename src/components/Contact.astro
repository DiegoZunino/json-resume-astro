---
/**
 * The end of the page, in a box in the colour of the sea: one way to write, not a repeat of
 * the buttons at the top. With the form configured (Netlify Forms) the box is the form, which
 * works without JavaScript (a normal POST and a confirmation page) and with JavaScript sends
 * in place and announces the result; without it, the address as one large button.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Resume } from '../core/schema';
import type { Labels } from '../i18n/labels';

interface Props {
  resume: Resume;
  labels: Labels;
  locale: string;
  privacyUrl: string;
  form: 'netlify' | undefined;
}

const { resume, labels, locale, privacyUrl, form } = Astro.props;
const { email } = resume.basics;
const text = labels.contact.form;
// On a narrow phone the address may break after the @ (<wbr>), never in the middle of a
// word; selected and copied, or read by a screen reader, it stays one address.
const at = email ? email.lastIndexOf('@') : -1;
/** Netlify identifies a form by its name, the same in every language. */
const FORM_NAME = 'contact';
---

<section class:list={['contact', 'section', { 'with-form': form }]} id="contact" aria-labelledby="contact-title">
  <h2 id="contact-title">{labels.sections.contact}</h2>
  {form === 'netlify' ? (
    <form
      class="form"
      name={FORM_NAME}
      method="POST"
      action={getRelativeLocaleUrl(locale, labels.contact.sentPage.slug)}
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-contact-form
      data-sending={text.sending}
      data-sent={text.sent}
      data-failed={text.failed}
    >
      <input type="hidden" name="form-name" value={FORM_NAME} />
      <p class="intro wide">{text.intro}</p>
      {/* A field people never see: bots fill it in, and Netlify drops what they send. */}
      <p class="trap" aria-hidden="true">
        <label>
          bot-field <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>
      <p class="field">
        <label for="contact-name">{text.name}</label>
        <input id="contact-name" type="text" name="name" autocomplete="name" required maxlength="200" />
      </p>
      <p class="field">
        <label for="contact-email">{text.email}</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="320" />
      </p>
      <p class="field wide">
        <label for="contact-message">{text.message}</label>
        <textarea id="contact-message" name="message" rows="5" required maxlength="5000"></textarea>
      </p>
      <p class="notice wide">
        {text.notice} <a href={privacyUrl}>{text.noticeLink}</a>
      </p>
      <p class="send wide">
        <button type="submit">{text.send}</button>
        <span class="status" role="status"></span>
      </p>
      {email && (
        <p class="fallback wide" data-fallback hidden>
          {text.fallback} <a href={`mailto:${email}`}>{email}</a>
        </p>
      )}
    </form>
  ) : (
    email && (
      <p class="email">
        <a class="address" href={`mailto:${email}`} aria-label={email}>
          {at > 0 ? <span>{[`${email.slice(0, at)}@`, <wbr />, email.slice(at + 1)]}</span> : email}
        </a>
      </p>
    )
  )}
</section>

<script>
  import { initContactForms } from '../site/contact-form';
  initContactForms();
</script>

<style>
  .contact {
    padding: 2.25rem clamp(1rem, 5vw, 2rem) 1.75rem;
    border-radius: 1.375rem;
    background: var(--fascia);
    color: var(--fascia-ink);
  }
  .email {
    margin: 0;
  }
  .address {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 3.125rem;
    padding: 0 clamp(0.75rem, 3vw, 1.375rem);
    border-radius: var(--radius);
    background: var(--gru);
    color: var(--gru-ink);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .address:hover {
    transform: translateY(-2px);
  }
  .contact :focus-visible {
    outline-color: var(--gru);
  }

  /* The form takes the whole box: white fields on the sea, labels above them; on wide
     screens name and email side by side, everything else across both columns. */
  .form {
    display: grid;
    gap: 0.875rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wide {
      grid-column: 1 / -1;
    }
  }
  .form p {
    margin: 0;
  }
  .intro {
    margin-bottom: 0.125rem !important;
  }
  .trap {
    display: none;
  }
  .field {
    display: grid;
    gap: 0.375rem;
  }
  .field label {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid var(--campo-bordo);
    border-radius: var(--radius);
    background: var(--campo);
    color: var(--campo-ink);
    font: inherit;
    font-size: 1rem;
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--gru);
    outline-offset: 2px;
  }
  /* A field left wrong after trying to send keeps a mark (no colour needed). */
  .field :is(input, textarea):user-invalid {
    border-width: 2px;
    border-style: dashed;
  }
  .notice {
    font-size: 0.875rem;
  }
  .notice a {
    color: inherit;
  }
  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.25rem !important;
  }
  .send button {
    min-height: 3.125rem;
    padding: 0 1.75rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--gru);
    color: var(--gru-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .send button[aria-disabled='true'] {
    opacity: 0.7;
    cursor: progress;
  }
  .fallback a {
    color: inherit;
    font-weight: 700;
  }
  .status {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .address:hover {
      transform: none;
    }
  }
  @media (forced-colors: active) {
    .contact,
    .address {
      border: 2px solid CanvasText;
    }
    .address {
      background: Canvas;
      color: LinkText;
    }
    .field input,
    .field textarea {
      border-color: CanvasText;
    }
    .send button {
      border: 2px solid ButtonText;
      background: ButtonFace;
      color: ButtonText;
    }
  }
  @media print {
    .contact {
      padding: 0;
    }
    /* A form means nothing on paper, and the contacts are already printed at the top. */
    .contact.with-form {
      display: none;
    }
    .address {
      padding: 0;
      min-height: 0;
      border: 0;
      background: none;
      color: var(--ardesia);
    }
  }
</style>
