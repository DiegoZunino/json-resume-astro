---
/**
 * The page's actions: one primary button (download the CV), then email and profiles as
 * secondary buttons with icon and label. Used under the hero and again at the end.
 */
import type { Resume } from '../core/schema';
import type { Labels } from '../i18n/labels';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  resume: Resume;
  labels: Labels;
  pdfUrl: string;
  /** Accessible name of the group (the actions appear under the hero and again at the end). */
  label: string;
  /** Show the email address in full, to read or copy (once per page is enough). */
  showEmail?: boolean;
}

const { resume, labels, pdfUrl, label, showEmail = false } = Astro.props;
const { email, profiles } = resume.basics;

const iconFor = (network = ''): IconName => {
  const name = network.toLowerCase();
  if (['github', 'gitlab', 'codeberg', 'bitbucket'].includes(name)) return 'code';
  if (['linkedin', 'xing'].includes(name)) return 'profile';
  return 'link';
};
const links = profiles.filter((profile) => profile.url);
---

<div class="actions" role="group" aria-label={label}>
  <a class="button primary" href={pdfUrl} download>
    <Icon name="download" />
    <span>
      {labels.downloadCv}
      <span class="detail">{labels.downloadCvDetail}</span>
    </span>
  </a>
  {email && (
    <a class="button" href={`mailto:${email}`}>
      <Icon name="mail" />
      <span>{labels.email}</span>
    </a>
  )}
  {links.map((profile) => (
    <a class="button" href={profile.url} rel="me">
      <Icon name={iconFor(profile.network)} />
      <span>{profile.network ?? profile.url}</span>
    </a>
  ))}
</div>
{showEmail && email && <p class="email muted small">{email}</p>}

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border: 1.5px solid var(--mare);
    border-radius: var(--radius);
    color: var(--mare);
    background: transparent;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .button:hover {
    background: color-mix(in srgb, var(--mare) 9%, transparent);
  }
  .primary {
    min-height: 3rem;
    background: var(--mare);
    color: var(--mare-ink);
  }
  .primary:hover {
    background: color-mix(in srgb, var(--mare) 88%, var(--ardesia));
  }
  .detail {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.9;
  }
  .email {
    margin: 0.75rem 0 0;
    user-select: all;
  }
  @media (max-width: 30rem) {
    .actions > * {
      flex: 1 1 calc(50% - 0.75rem);
      justify-content: center;
    }
    .actions > .primary {
      flex-basis: 100%;
    }
  }
  @media print {
    .actions,
    .email {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .button {
      border-color: ButtonText;
    }
  }
</style>
