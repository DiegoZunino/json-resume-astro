---
/**
 * The first screen's actions: one primary button (download the CV), then email, "Add to
 * contacts" (the contact card) and the profiles as secondary buttons. Text only: the labels
 * are short and clear on their own. They are the only contact links on the page: the box at
 * the end holds the form (or, without it, the address).
 */
import type { Resume } from '../core/schema';
import type { Labels } from '../i18n/labels';

interface Props {
  resume: Resume;
  labels: Labels;
  pdfUrl: string;
  vcardUrl: string;
  /** Accessible name of the group. */
  label: string;
}

const { resume, labels, pdfUrl, vcardUrl, label } = Astro.props;
const { email, profiles } = resume.basics;
const links = profiles.filter((profile) => profile.url);
---

<div class="actions" role="group" aria-label={label}>
  <a class="button primary" href={pdfUrl} download>
    <span>
      {labels.downloadCv} <span class="detail">{labels.downloadCvDetail}</span>
    </span>
  </a>
  {email && (
    <a class="button" href={`mailto:${email}`} data-href={email}>
      {labels.email}
    </a>
  )}
  <a class="button" href={vcardUrl} download type="text/vcard">
    {labels.contact.vcard}
  </a>
  {links.map((profile) => (
    <a class="button" href={profile.url} rel="me" data-href={profile.url}>
      {profile.network ?? profile.url}
    </a>
  ))}
</div>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.125rem;
    padding: 0 1.25rem;
    border: 1.5px solid var(--bordo);
    border-radius: var(--radius);
    color: var(--mare);
    background: transparent;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  .button:hover {
    transform: translateY(-2px);
    border-color: var(--mare);
  }
  .primary {
    padding-inline: 1.5rem;
    border-color: var(--mare);
    background: var(--mare);
    color: var(--mare-ink);
    font-size: 1rem;
    font-weight: 700;
  }
  /* Inside one inline run with the label, so both sit on the same baseline. */
  .detail {
    margin-left: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.85;
  }
  /* Up to tablet width: the download button on its own row, the secondary buttons two by two
     below it (email with the contact card, then the profiles). */
  @media (max-width: 46rem) {
    .actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .actions > .primary {
      grid-column: 1 / -1;
    }
    .actions > :not(.primary) {
      padding-inline: 0.5rem;
      text-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .button:hover {
      transform: none;
    }
  }
  @media (forced-colors: active) {
    .button {
      border-color: ButtonText;
    }
    .primary {
      forced-color-adjust: none;
      background: ButtonText;
      color: ButtonFace;
    }
  }
  /* On paper the buttons become plain contact lines; the downloads have no meaning there. */
  @media print {
    .button[download] {
      display: none;
    }
    .actions {
      display: block;
    }
    .button {
      display: block;
      min-height: 0;
      padding: 0;
      border: 0;
      color: var(--ardesia);
      font-weight: 400;
    }
    .button[data-href]::after {
      content: ' ' attr(data-href);
    }
  }
</style>
