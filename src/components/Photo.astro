---
/**
 * Profile photo (see site/photo.ts). If there is no photo, or it cannot be fetched, a
 * monogram takes its place so the layout never breaks. The photo sits next to the name,
 * so its alternative text is empty (WCAG H67).
 */
import { initials } from '../core/text';
import { optimisedPhoto } from '../site/photo';

interface Props {
  src?: string | undefined;
  name: string;
  /** Largest displayed size in CSS pixels; files are generated up to twice that size. */
  size: number;
  /** Displayed size for the browser to pick a file (the `sizes` attribute). */
  sizes?: string;
  class?: string;
  eager?: boolean;
}

const { src, name, size, sizes = `${size}px`, class: className, eager = false } = Astro.props;
const image = await optimisedPhoto(src, size);
---

{image ? (
  <img
    class:list={['photo', className]}
    src={image.src}
    srcset={image.srcSet.attribute}
    sizes={sizes}
    width={size}
    height={size}
    alt=""
    decoding="async"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : (
  <span class:list={['photo', 'monogram', className]} aria-hidden="true">
    {initials(name)}
  </span>
)}

<style>
  /* The parent sets the displayed size with --photo-size (no inline styles: strict CSP). */
  .photo {
    width: var(--photo-size, 5rem);
    height: var(--photo-size, 5rem);
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    background: var(--superficie);
    box-shadow: 0 0 0 1px var(--linea);
  }
  .monogram {
    display: grid;
    place-items: center;
    color: var(--mare);
    font-weight: 700;
    font-size: calc(var(--photo-size, 5rem) * 0.36);
    letter-spacing: -0.02em;
  }
</style>
