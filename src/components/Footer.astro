---
/**
 * What the site is (a small open-source project, with a link to its code and data),
 * when it was updated, the accessibility statement and the other languages.
 */
import { formatLongDate } from '../core/dates';
import { hostName, type Labels } from '../i18n/labels';
import type { LocaleLink } from '../site/context';
import Icon from './Icon.astro';

interface Props {
  labels: Labels;
  updated: Date | undefined;
  repository: string | undefined;
  accessibilityUrl: string;
  dataUrl: string;
  otherLocales: LocaleLink[];
}

const { labels, updated, repository, accessibilityUrl, dataUrl, otherLocales } = Astro.props;
---

<footer class="footer page">
  <div class="inner">
    {repository ? (
      <div class="project">
        <p class="measure">{labels.footer.project}</p>
        <p class="links">
          <a class="source" href={repository} data-repository>
            <Icon name="code" size={18} />
            <span>{labels.footer.source(hostName(repository))}</span>
          </a>
          <a href={dataUrl} type="application/json">
            {labels.footer.data}
          </a>
        </p>
      </div>
    ) : (
      <p>
        {labels.footer.builtWith}{' '}
        <a href={dataUrl} type="application/json">
          {labels.footer.data}
        </a>
      </p>
    )}
    <p class="meta">
      {updated && (
        <span>
          {labels.footer.updated}{' '}
          <time datetime={updated.toISOString().slice(0, 10)}>{formatLongDate(updated, labels.intl)}</time>
        </span>
      )}
      <a href={accessibilityUrl}>{labels.footer.accessibility}</a>
      {otherLocales.map((link) => (
        <a href={link.href} hreflang={link.locale} lang={link.locale}>
          {link.name}
        </a>
      ))}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 2.5rem;
    padding-bottom: 2.5rem;
    color: var(--nebbia);
    font-size: var(--step--1);
  }
  .inner {
    padding-top: 0.5rem;
  }
  .footer p {
    margin: 0 0 0.75rem;
  }
  .project {
    margin-bottom: 0.5rem;
  }
  .links,
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }
  .links a,
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .source {
    gap: 0.45rem;
  }
  @media print {
    .footer {
      display: none;
    }
  }
</style>
