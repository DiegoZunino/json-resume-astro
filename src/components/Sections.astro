---
/** Renders the visible sections in theme order. */
import { buildDate } from '../core/dates';
import { entriesFor, extensionEntries, listLanguage } from '../core/entries';
import type { Section } from '../core/sections';
import type { Resume } from '../core/schema';
import { sectionTitle, type Labels } from '../i18n/labels';
import Education from './sections/Education.astro';
import ItemList from './sections/ItemList.astro';
import SectionShell from './sections/SectionShell.astro';
import Skills from './sections/Skills.astro';
import Timeline from './Timeline.astro';
import TimelineToggle from './TimelineToggle.astro';
import { offersExpandAll } from '../core/timeline';

interface Props {
  sections: Section[];
  resume: Resume;
  labels: Labels;
  reference: Date;
}

const { sections, resume, labels, reference } = Astro.props;
const overrides = resume.meta.themeOptions?.labels ?? {};
const expanded = resume.meta.themeOptions?.expanded ?? 2;
const title = (key: string) => sectionTitle(key, labels, overrides);
---

{sections.map((section) => (
  <SectionShell id={section.key} title={title(section.key)}>
    {section.key === 'work' && offersExpandAll(resume.work, expanded) && (
      <TimelineToggle slot="tools" labels={labels} />
    )}
    {section.kind === 'extension' ? (
      <ItemList
        entries={extensionEntries(section.items, { ...labels, today: buildDate(), locale: labels.intl })}
        note={listLanguage(section.items, labels.intl, labels.inLanguage)?.note}
      />
    ) : section.kind === 'education' ? (
      <Education resume={resume} labels={labels} />
    ) : section.key === 'work' ? (
      <Timeline work={resume.work} labels={labels} reference={reference} expanded={expanded} />
    ) : section.key === 'skills' ? (
      <Skills skills={resume.skills} />
    ) : (
      <ItemList entries={entriesFor(section.key, resume, labels)} />
    )}
  </SectionShell>
))}
