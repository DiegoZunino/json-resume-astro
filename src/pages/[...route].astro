---
/**
 * Every locale gets a home page (the default locale at the root), an accessibility
 * statement, a privacy notice and, with the contact form, the page shown after sending
 * without JavaScript. Routing follows Astro's i18n configuration (prefixDefaultLocale: false).
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import Contact from '../components/Contact.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import { formatLongDate } from '../core/dates';
import { labelsFor, PRIVACY_DATE, STATEMENT_DATE } from '../i18n/labels';
import Web from '../layouts/Web.astro';
import { alternatesFor, contactForm, locales, pageContext, routeParam } from '../site/context';

export const getStaticPaths = (() =>
  locales.flatMap((locale) => {
    const labels = labelsFor(locale);
    const route = (slug?: string) => routeParam(getRelativeLocaleUrl(locale, slug));
    return [
      { params: { route: route() }, props: { locale, page: 'home' as const } },
      { params: { route: route(labels.accessibility.slug) }, props: { locale, page: 'accessibility' as const } },
      { params: { route: route(labels.privacy.slug) }, props: { locale, page: 'privacy' as const } },
      ...(contactForm
        ? [{ params: { route: route(labels.contact.sentPage.slug) }, props: { locale, page: 'sent' as const } }]
        : []),
    ];
  })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale, page } = Astro.props;
const context = await pageContext(locale, Astro.site);
const { resume, labels } = context;
const statementUrl = (other: string) => getAbsoluteLocaleUrl(other, labelsFor(other).accessibility.slug);
const privacyUrl = (other: string) => getAbsoluteLocaleUrl(other, labelsFor(other).privacy.slug);
const email = resume.basics.email;
/** A paragraph split around the owner's address, so the address can be a link. */
const withEmailLink = (paragraph: string): string[] =>
  email ? paragraph.split(email).flatMap((part, index) => (index ? [email, part] : [part])) : [paragraph];
const back = `← ${labels.backTo(resume.basics.name)}`;
---

{page === 'home' ? (
  <Web context={context} structuredData>
    <Hero resume={resume} labels={labels} pdfUrl={context.pdfUrl} vcardUrl={context.vcardUrl} />
    <Sections sections={context.sections} resume={resume} labels={labels} reference={context.reference} />
    <Contact
      resume={resume}
      labels={labels}
      locale={locale}
      privacyUrl={context.privacyUrl}
      form={context.contactForm}
    />
  </Web>
) : page === 'privacy' ? (
  <Web
    context={context}
    title={`${labels.privacy.title} · ${resume.basics.name}`}
    canonical={privacyUrl(locale)}
    alternates={alternatesFor(privacyUrl)}
    current="privacy"
  >
    <article class="statement measure">
      <p class="back">
        <a href={context.homeUrl}>{back}</a>
      </p>
      <h1>{labels.privacy.title}</h1>
      {labels.privacy.sections(context.privacy).map((notice) => (
        <section>
          <h2>{notice.title}</h2>
          {notice.paragraphs.map((paragraph) => (
            <p>
              {withEmailLink(paragraph).map((part) =>
                part === email ? <a href={`mailto:${email}`}>{email}</a> : part,
              )}
            </p>
          ))}
        </section>
      ))}
      <p class="muted small">
        {labels.privacy.reviewed}{' '}
        <time datetime={PRIVACY_DATE}>{formatLongDate(new Date(PRIVACY_DATE), labels.intl)}</time>
      </p>
    </article>
  </Web>
) : page === 'sent' ? (
  <Web context={context} title={`${labels.contact.sentPage.title} · ${resume.basics.name}`} noindex>
    <article class="statement measure">
      <h1>{labels.contact.sentPage.title}</h1>
      <p>{labels.contact.sentPage.body}</p>
      <p class="back">
        <a href={context.homeUrl}>{back}</a>
      </p>
    </article>
  </Web>
) : (
  <Web
    context={context}
    title={`${labels.accessibility.title} · ${resume.basics.name}`}
    canonical={statementUrl(locale)}
    alternates={alternatesFor(statementUrl)}
    current="accessibility"
  >
    <article class="statement measure">
      <p class="back">
        <a href={context.homeUrl}>{back}</a>
      </p>
      <h1>{labels.accessibility.title}</h1>
      {labels.accessibility.paragraphs(resume.basics.email).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p class="muted small">
        {labels.accessibility.reviewed}{' '}
        <time datetime={STATEMENT_DATE}>{formatLongDate(new Date(STATEMENT_DATE), labels.intl)}</time>
      </p>
    </article>
  </Web>
)}

<style>
  .statement {
    padding-top: 2rem;
  }
  .statement h1 {
    font-size: var(--step-3);
    margin: 0.5rem 0 1.5rem;
  }
  .statement h2 {
    font-size: var(--step-1);
    margin: 1.75rem 0 0.5rem;
  }
</style>
